{
  "name": "dsh-mail-bot",
  "version": "0.1.0",
  "description": "DSH 邮件助手插件：手机发邮件遥控 DSH 干活，支持主动来信",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "mail",
    "imap",
    "smtp",
    "automation"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    
    "test","lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "imapflow": "^1.0.164",
    "mailparser": "^3.7.1",
    "nodemailer": "^6.9.16"
  },
  "scripts": {
    "test": "node test/smoke.mjs && node test/routes.mjs && node test/race.mjs && node test/exhaustive.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "author": "QIKO0721",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QIKO0721/dsh-mail-bot.git"
  },
  "homepage": "https://github.com/QIKO0721/dsh-mail-bot#readme",
  "license": "MIT"
}
